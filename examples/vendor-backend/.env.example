# Copy to `.env` and fill in. The example loads it via `node --env-file=.env`
# (Node 20+) or your process manager; see README.

# Port the callback server listens on.
PORT=8787

# The path your `callbackUrl` points at. Must match what you registered as the
# app's allowed callback hostname + this path, e.g.
# https://your-host:8787/flow/callback
CALLBACK_PATH=/flow/callback

# Your full registered callback URL. Sent as `redirect_uri` in the PKCE code
# exchange when set (some token endpoints require it to match what was
# registered). Optional — leave unset to omit it.
PUBLIC_CALLBACK_URL=https://your-host:8787/flow/callback

# Per-app shared secret, set in Flow admin (Registered Apps → remote auth).
# Used to verify the X-NS-Signature HMAC.
FLOW_CALLBACK_SECRET=replace-with-the-secret-from-registered-apps

# Your app id, as registered in Flow. The cluster-verification JWT's `appId`
# claim must match this.
FLOW_APP_ID=flow-extension-demo

# INSight JWKS endpoint used to verify the X-NS-Cluster-Verification JWT.
# Operators on beta/dev may publish a different host.
INSIGHT_JWKS_URL=https://insight.netsapiens.com/.well-known/jwks.json
INSIGHT_ISSUER=https://insight.netsapiens.com

# Secret used to sign the vendor's OWN tokens (this is your token, not NS's).
# REQUIRED: the server refuses to start if this is unset or left at a well-known
# insecure value — a weak secret here lets anyone forge trusted vendor tokens.
VENDOR_JWT_SECRET=replace-with-a-long-random-string
VENDOR_TOKEN_TTL_SECONDS=3600

# MOCK_MODE=1 skips the live code exchange (and, having no cluster, runs without
# a cluster-JWT header) so you can smoke-test HMAC verification + response
# shaping locally with no NetSapiens cluster. NEVER set this in production.
MOCK_MODE=0
